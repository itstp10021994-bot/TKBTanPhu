# Copy file này thành .streamlit/secrets.toml (chạy trên máy) hoặc dán nội
# dung vào Settings -> Secrets trên Streamlit Cloud. Chỉ cần 1 trong 2 mục.
# Hướng dẫn chi tiết: HUONG_DAN_SHAREPOINT.md

# Cách 1: Microsoft Graph (App Registration)
[sharepoint]
tenant_id     = ""
client_id     = ""
client_secret = ""
site_url      = "https://tenmien.sharepoint.com/sites/TKB"
folder        = "TKB_TanPhu"

# (tuỳ chọn) đổi tên List cho từng bảng — mặc định: ToChuyenMon, GiaoVien, LopHoc,
# PhongDacBiet, MonHocPhanCong, GioHocTheoKhoi, DanhSachHocSinhThi, DanhSachPhongThi, MonThi
# [sharepoint.lists]
# classes = "LopHoc"

# Cách 2 + 3: Power Automate (flow HTTP trigger) — không cần quyền admin
# [power_automate]
# sp_url   = ""   # Cách 3: 1 flow đồng bộ SharePoint List (kể cả "Danh sách của tôi")
# save_url = ""
# list_url = ""
# load_url = ""

# ---------------------------------------------------------------------
# Đăng nhập & phân quyền — xem PHAN_QUYEN.md (bỏ trống = không cần đăng nhập)
# A. Tài khoản Microsoft của trường (email Outlook)
# ---------------------------------------------------------------------
# [auth]
# redirect_uri        = "https://<ten-app>.streamlit.app/oauth2callback"
# cookie_secret       = "<chuỗi ngẫu nhiên>"
# client_id           = "<Application (client) ID>"
# client_secret       = "<client secret>"
# server_metadata_url = "https://login.microsoftonline.com/<tenant_id>/v2.0/.well-known/openid-configuration"
#
# [phan_quyen]
# otp_url      = ""   # C. flow gửi mã đăng nhập qua email (không cần admin)
# admin_emails = ["it.stp@igcschool.edu.vn"]
# domains      = ["igcschool.edu.vn"]
#
# B. Tài khoản nội bộ (tuỳ chọn) — password_hash tạo trong module 👥
# [phan_quyen.users.admin]
# name          = "Quản trị viên"
# role          = "admin"
# password_hash = "pbkdf2_sha256$200000$...$..."
