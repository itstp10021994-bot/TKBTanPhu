# Copy file này thành .streamlit/secrets.toml (chạy trên máy) hoặc dán nội
# dung vào Settings -> Secrets trên Streamlit Cloud. Chỉ cần 1 trong 2 mục.
# Hướng dẫn chi tiết: HUONG_DAN_SHAREPOINT.md

# Cách 1: Microsoft Graph (App Registration)
[sharepoint]
tenant_id     = ""
client_id     = ""
client_secret = ""
site_url      = "https://tenmien.sharepoint.com/sites/TKB"
folder        = "TKB_TanPhu"

# (tuỳ chọn) đổi tên List cho từng bảng — mặc định: ToChuyenMon, GiaoVien, LopHoc,
